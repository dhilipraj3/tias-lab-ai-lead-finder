{
  "name": "tias-lab-ai-lead-finder",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "opennextjs-cloudflare build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev",
    "cf:deploy": "opennextjs-cloudflare build && wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply tias-lead-finder-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply tias-lead-finder-db --remote"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.0.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
